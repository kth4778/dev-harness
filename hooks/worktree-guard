#!/usr/bin/env bash
# PreToolUse(Bash) — 에이전트가 도는 동안 작업 트리를 옮기지 못하게 한다.
#
# 왜 있나 (2026-08-06 POK-85):
#
#   오케스트레이터가 구현자·검토자가 작업 중인 저장소에서 git checkout 을 했다.
#   세 번 그랬다. 남에게는 "겹치지 마라"를 계속 강제하면서 자기가 어겼다.
#   구현자가 매번 별도 worktree 를 만들어 피해서 살렸지, 안 그랬으면 커밋이
#   엉뚱한 브랜치로 갔거나 작업이 통째로 날아갔다.
#
#   글로 쓴 규칙은 세 번 다 안 지켜졌다. 그래서 기계로 옮긴다.
#
# 막는 것은 "작업 트리를 옮기는 명령"뿐이다. 조회·커밋·push 는 안 건드린다 —
# 에이전트가 자기 브랜치에서 하는 정상 작업이다.
#
# 우회는 worktree 다. 그게 옳은 답이라 메시지로 안내한다.

set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
source "$here/lib-input"

read_hook_input
cmd=$(json_field "tool_input.command")
[ -z "$cmd" ] && exit 0

flat=$(printf '%s' "$cmd" | tr '\n' ' ')

# 트리를 옮기는 것만 본다. checkout 은 파일 복원(-- 뒤에 경로)에도 쓰이므로
# 그 형태는 통과시킨다 — 검토자가 실험을 원복할 때 쓰는 정상 경로다.
moves=0
printf '%s' "$flat" | grep -Eq '(^|[;&|[:space:]])git[[:space:]]+(switch|checkout)([[:space:]]|$)' && moves=1
printf '%s' "$flat" | grep -Eq '(^|[;&|[:space:]])git[[:space:]]+checkout[[:space:]]+(-{1,2}[[:space:]]|--[[:space:]])' && moves=0
printf '%s' "$flat" | grep -Eq '(^|[;&|[:space:]])git[[:space:]]+reset[[:space:]]+--hard' && moves=1
[ "$moves" = "0" ] && exit 0

# 에이전트가 실제로 도는 중인지는 훅이 알 수 없다. 표식 파일로 본다.
# 오케스트레이터가 에이전트를 띄울 때 만들고 끝나면 지운다.
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
busy="$root/.harness/agents-running"
[ -f "$busy" ] || exit 0

who=$(head -5 "$busy" 2>/dev/null | tr '\n' ' ')

block "차단됨 — 에이전트가 이 저장소에서 작업 중이다. 트리를 옮기지 마라.

    도는 중: $who
    막힌 명령: $cmd

에이전트는 이 작업 트리에서 파일을 고치고 커밋한다. 지금 브랜치를 옮기면
그 작업이 엉뚱한 브랜치로 가거나 통째로 날아간다.

2026-08-06에 오케스트레이터가 이걸 세 번 했다. 구현자가 매번 별도 worktree로
피해서 살았지 규칙이 지켜진 것이 아니다.

할 일 — 둘 중 하나다.

  1. 에이전트가 끝날 때까지 기다린다 (권장)
  2. 별도 worktree에서 작업한다:
       git worktree add -d <임시경로> <브랜치>
       # 일이 끝나면
       git worktree remove --force <임시경로>

이 검사를 끄려면 .harness/agents-running 을 지운다. 지운다는 것은
'지금 도는 에이전트가 없다'는 뜻이지 '이번만 봐준다'가 아니다."

#!/usr/bin/env bash
# Stop — PR이 머지됐는데 세션이 마감되지 않았으면 턴 종료를 막는다.
#
# 판정은 기계적으로 한다: 현재 feature 브랜치가 통합 브랜치에 완전히
# 포함됐고(= 머지됨), [3] 자리가 아직 차 있으면 마감 누락이다.
# 작업이 진행 중인 경우는 브랜치가 머지되지 않았으므로 걸리지 않는다.

set -uo pipefail

# 무한 루프 방지 — 이미 이 훅 때문에 멈춘 상태면 통과시킨다
input=$(cat)
case "$input" in
    *'"stop_hook_active":true'*) exit 0 ;;
esac

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0
source "$(cd "$(dirname "$0")" && pwd)/lib-repo"
root=$(project_dir)
cd "$root" || exit 0

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
case "$branch" in
    feature/*) ;;
    *) exit 0 ;;
esac

# [3] 자리가 비었으면 마감된 것이다
leftovers=""
[ -d "$root/_workspace" ] && leftovers="${leftovers} _workspace/"
[ -n "$(ls -A "$root/.claude/agents" 2>/dev/null)" ] && leftovers="${leftovers} .claude/agents/"
[ -n "$(ls -A "$root/.claude/skills" 2>/dev/null)" ] && leftovers="${leftovers} .claude/skills/"
[ -z "$leftovers" ] && exit 0

# 이 브랜치가 통합 브랜치에 이미 들어갔나 = PR이 머지됐나.
# 이름을 박아두면 그 브랜치가 없는 저장소에서 훅이 통째로 죽는다.
source "$(cd "$(dirname "$0")" && pwd)/lib-repo"
base=$(default_branch)
[ -z "$base" ] && exit 0
git rev-parse --verify -q "origin/$base" >/dev/null 2>&1 || exit 0
unmerged=$(git rev-list --count "origin/$base..HEAD" 2>/dev/null || echo 1)
[ "$unmerged" != "0" ] && exit 0

reason="PR이 머지됐는데 세션이 마감되지 않았다. 남아 있는 [3] 자리:${leftovers}

wrap 스킬로 마감한다 — 세션 기록을 쓰고, _archive/{날짜}-{기능}/으로 옮기고,
자리를 비운다. 자리를 안 비우면 다음 기능의 산출물과 섞여서 어느 파일이 어느
기능 것인지 알 수 없게 된다.

CLAUDE.md(3층)는 [2]이므로 옮기지 않는다."

# Stop 훅의 차단 규약은 JSON의 decision:block 이다
esc=$(printf '%s' "$reason" | sed 's/\\/\\\\/g; s/"/\\"/g' | sed ':a;N;$!ba;s/\n/\\n/g')
printf '{"decision":"block","reason":"%s"}\n' "$esc"
exit 0

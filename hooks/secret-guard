#!/usr/bin/env bash
# PreToolUse(Bash) — 시크릿이 섞인 커밋을 막는다.
#
# public 저장소에 OAuth 시크릿·AWS 키·토큰이 한 번 올라가면 지워도 히스토리에
# 남는다. 커밋 전에 커밋될 내용을 훑어 막는다.

set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
source "$here/lib-input"
source "$here/lib-cmd"

read_hook_input
cmd=$(json_field "tool_input.command")
[ -z "$cmd" ] && exit 0

flat=$(flatten_command "$cmd")

is_commit_command "$flat" || exit 0
cd_to_target_repo "$flat" || exit 0

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

files=$(committed_files "$flat")
[ -z "$files" ] && exit 0

PATTERNS='sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

hits=""
while IFS= read -r f; do
    [ -n "$f" ] || continue
    if committed_content "$flat" "$f" | grep -qE "$PATTERNS"; then
        hits="$hits
  $f"
    fi
done <<EOF
$files
EOF

if [ -n "$hits" ]; then
    block "차단됨 — 시크릿으로 보이는 문자열이 커밋에 들어간다:
$hits

한 번 올라가면 지워도 히스토리에 남는다. 스테이지에서 내리고 값을 환경변수로 옮긴다:
    git restore --staged <파일>"
fi

exit 0

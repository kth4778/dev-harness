#!/usr/bin/env bash
# PreToolUse(Bash) — 시크릿이 섞인 커밋을 막는다.
#
# 키가 한 번 올라가면 지워도 히스토리에 남는다. 커밋 전에 잡는다.

set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
source "$here/lib-input"

read_hook_input
cmd=$(json_field "tool_input.command")
[ -z "$cmd" ] && exit 0

flat=$(printf '%s' "$cmd" | tr '\n' ' ')

# git 과 commit 사이에 전역 옵션이 낀다. `git -c user.name=x commit`·`git --no-pager commit`
# 이 전부 정상 명령인데, 둘을 붙여서만 찾으면 그 커밋들이 검사를 통째로 빠져나간다.
printf '%s' "$flat" | grep -Eq '(^|[;&|[:space:]])git([[:space:]]+-[^[:space:]]+)*[[:space:]]+commit([[:space:]]|$)' || exit 0

# 명령이 다른 저장소로 옮겨 가서 커밋하면(`cd ../other && git commit`) 여기서 판정할
# 근거가 없다. 세션 저장소를 검사해 봐야 남의 저장소를 통과시키는 셈이라, 아예 비킨다.
if printf '%s' "$flat" | grep -Eq '(^|[;&|[:space:]])cd[[:space:]]'; then
    exit 0
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

# `git commit -a`는 추적 파일의 워킹트리 변경을 커밋 순간에 스스로 스테이징한다.
# 인덱스만 보면 그 변경이 안 보여서 그대로 통과한다.
commit_all=no
printf '%s' "$flat" | grep -Eq 'commit([[:space:]]+-[^[:space:]]*a[^[:space:]]*)|commit[^;&|]*--all' && commit_all=yes

# 시크릿 모양. 짧은 접두사만 보면 오탐이 많아 길이까지 건다.
PATTERNS='sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

hits=""

# -z 로 받고 NUL 로 끊는다. 공백·한글이 든 파일 이름을 for 로 돌면 단어가 쪼개져
# 검사에서 조용히 빠진다 — 막아야 할 파일이 이름 때문에 통과하는 모양이다.
scan() {
    local src=$1 label=$2 f found
    while IFS= read -r -d '' f; do
        # 워킹트리가 아니라 그 소스가 가진 내용을 본다. 스테이징한 뒤 파일에서
        # 키를 지우면, 디스크에는 없고 커밋에는 남는다.
        found=$(git show "$src$f" 2>/dev/null | grep -nE "$PATTERNS")
        [ -n "$found" ] && hits="$hits\n  $f ($label)"
    done
}

git diff --cached --name-only -z --diff-filter=ACMR | scan ':' '스테이지'
[ "$commit_all" = yes ] && git diff --name-only -z --diff-filter=ACMR | scan 'HEAD:' '커밋 대상'

if [ -n "$hits" ]; then
    printf '차단됨 — 시크릿으로 보이는 문자열이 있다:%b\n\n지우고 다시 커밋해라. 한 번 올라가면 히스토리에서 안 지워진다.\n' "$hits" >&2
    exit 2
fi

exit 0

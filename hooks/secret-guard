#!/usr/bin/env bash
# PreToolUse(Bash) — 시크릿이 섞인 커밋을 막는다.
#
# public 저장소에 OAuth 시크릿·AWS 키·토큰이 한 번 올라가면 지워도 히스토리에
# 남는다. 커밋 전에 스테이징된 내용을 훑어 막는다.
#
# commit-guard와 같은 자리(커밋 명령 감지·대상 저장소 판정)를 쓴다.
# 그쪽을 고칠 일이 생기면 여기도 같이 고친다.

set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
source "$here/lib-input"

read_hook_input
cmd=$(json_field "tool_input.command")
[ -z "$cmd" ] && exit 0

flat=$(printf '%s' "$cmd" | tr '\n' ' ')

# 문자열 "git commit"을 그대로 찾으면 안 된다 — `git -C <경로> commit`이나
# `git --no-pager commit`처럼 사이에 옵션이 끼면 통째로 안 걸린다.
# commit-guard가 2026-08-09에 막은 구멍이고, 이 훅에도 같은 것이 있었다.
printf '%s' "$flat" \
    | grep -Eq '(^|[;&|[:space:]])git([[:space:]]+(-[cC][[:space:]]+("[^"]+"|[^[:space:]]+)|--?[^[:space:]]+))*[[:space:]]+commit([[:space:]]|$)' \
    || exit 0

# 훅은 명령의 cwd가 아니라 세션 cwd에서 돈다. 명령이 대상 저장소를 밝혔으면
# (앞머리의 cd <경로> 또는 git -C <경로>) 거기서 판정한다. 앞머리의 cd를 먼저
# 보는 이유는 `git -C`가 커밋 메시지 본문에도 나올 수 있기 때문이다.
target=$(printf '%s' "$flat" | grep -oE '^[[:space:]]*cd[[:space:]]+("[^"]+"|[^[:space:]]+)' | head -1 \
    | sed -E 's/^[[:space:]]*cd[[:space:]]+//; s/^"//; s/"$//')
if [ -z "$target" ]; then
    target=$(printf '%s' "$flat" | grep -oE 'git[[:space:]]+-C[[:space:]]+("[^"]+"|[^[:space:]]+)' | head -1 \
        | sed -E 's/^git[[:space:]]+-C[[:space:]]+//; s/^"//; s/"$//')
fi
if [ -n "$target" ] && [ -d "$target" ] \
        && git -C "$target" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    cd "$target" || exit 0
fi

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

# 워킹트리가 아니라 인덱스를 읽는다. 스테이징한 뒤에 파일을 고치면 둘이
# 어긋나고, 커밋에 실제로 들어가는 것은 인덱스 쪽이다.
files=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)
[ -z "$files" ] && exit 0

PATTERNS='sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

hits=""
while IFS= read -r f; do
    [ -n "$f" ] || continue
    if git show ":$f" 2>/dev/null | grep -qE "$PATTERNS"; then
        hits="$hits
  $f"
    fi
done <<EOF
$files
EOF

if [ -n "$hits" ]; then
    block "차단됨 — 시크릿으로 보이는 문자열이 스테이지에 있다:
$hits

한 번 올라가면 지워도 히스토리에 남는다. 스테이지에서 내리고 값을 환경변수로 옮긴다:
    git restore --staged <파일>"
fi

exit 0

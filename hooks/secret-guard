#!/usr/bin/env bash
# PreToolUse(Bash) — 시크릿이 섞인 커밋을 막는다.
#
# public 저장소에 OAuth 시크릿·AWS 키·토큰이 한 번 올라가면 지워도 히스토리에
# 남는다. 커밋 전에 스테이징된 내용을 훑어 막는다.

set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
source "$here/lib-input"

read_hook_input
cmd=$(json_field "tool_input.command")
[ -z "$cmd" ] && exit 0

flat=$(printf '%s' "$cmd" | tr '\n' ' ')

# 커밋에만 건다.
printf '%s' "$flat" | grep -Eq '(^|[;&|[:space:]])git[[:space:]]+commit([[:space:]]|$)' || exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

# 스테이징된 파일 목록.
files=$(git diff --cached --name-only)
[ -z "$files" ] && exit 0

PATTERNS='sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

hits=""
for f in $files; do
    [ -f $f ] || continue
    found=$(grep -nE "$PATTERNS" $f)
    if [ -n "$found" ]; then
        hits="$hits\n  $f"
    fi
done

if [ -n "$hits" ]; then
    printf '시크릿으로 보이는 문자열이 있다:%b\n' "$hits" >&2
    exit 2
fi

exit 0

# 주석 한 줄 — push 트리거 시험용

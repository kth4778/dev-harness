#!/usr/bin/env bash
# PreToolUse(Bash) — 시크릿이 섞인 커밋을 막는다.

set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
source "$here/lib-input"

read_hook_input
cmd=$(json_field "tool_input.command")
[ -z "$cmd" ] && exit 0

flat=$(printf '%s' "$cmd" | tr '\n' ' ')
printf '%s' "$flat" | grep -Eq '(^|[;&|[:space:]])git[[:space:]]+commit([[:space:]]|$)' || exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

files=$(git diff --cached --name-only)
[ -z "$files" ] && exit 0

PATTERNS='sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}'

hits=""
for f in $files; do
    [ -f $f ] || continue
    found=$(grep -nE "$PATTERNS" $f)
    if [ -n "$found" ]; then
        hits="$hits\n  $f"
    fi
done

if [ -n "$hits" ]; then
    printf '시크릿으로 보이는 문자열이 있다:%b\n' "$hits" >&2
    exit 2
fi

exit 0

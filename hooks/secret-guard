#!/usr/bin/env bash
# PreToolUse(Bash) — 시크릿이 섞인 커밋을 막는다.
#
# public 저장소에 OAuth 시크릿·AWS 키·토큰이 한 번 올라가면 지워도 히스토리에
# 남는다. 커밋 전에 커밋될 수 있는 내용을 훑어 막는다.
#
# **넓게 본다.** 인덱스뿐 아니라 추적 파일의 워킹트리 변경까지 검사한다.
# `git commit -a` 인지 가리려다 다섯 라운드를 실패한 뒤 판정을 버렸다 —
# 자세한 것은 lib-cmd 머리말에 있다. 스테이징 안 한 시크릿까지 걸리지만,
# 추적 파일에 시크릿이 들어앉은 상태 자체가 위험하니 막는 편이 맞다.

set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
source "$here/lib-input"
source "$here/lib-cmd"

read_hook_input
cmd=$(json_field "tool_input.command")
[ -z "$cmd" ] && exit 0

flat=$(flatten_command "$cmd")

is_commit_command "$flat" || exit 0
cd_to_target_repo "$flat" || exit 0

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

files=$(committable_files)
[ -z "$files" ] && exit 0

PATTERNS='sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

hits=""
while IFS= read -r f || [ -n "$f" ]; do
    [ -n "$f" ] || continue
    # `grep -q` 를 쓰면 안 된다. 매치하자마자 grep 이 닫혀 앞쪽 함수가 SIGPIPE 로
    # 죽고, `set -o pipefail` 이 그것을 파이프라인 실패로 읽어 **차단이 통째로
    # 사라진다.** 2026-08-11에 실물로 겪었다 — 시험 13개가 한꺼번에 빨간불이 됐다.
    if committable_content "$f" | grep -E "$PATTERNS" >/dev/null 2>&1; then
        hits="$hits
  $f"
    fi
done <<EOF
$files
EOF

if [ -n "$hits" ]; then
    block "차단됨 — 시크릿으로 보이는 문자열이 커밋에 들어갈 수 있다:
$hits

한 번 올라가면 지워도 히스토리에 남는다. 값을 환경변수로 옮기고 파일에서 지운다.
스테이지에 올라와 있으면 함께 내린다:
    git restore --staged <파일>

이 검사는 인덱스와 워킹트리를 **둘 다** 본다. 아직 스테이징하지 않았어도
추적 중인 파일에 시크릿이 있으면 걸린다."
fi

exit 0

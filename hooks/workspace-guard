#!/usr/bin/env bash
# PreToolUse(Write|Edit) — 세션 격리를 강제한다.
#
# _archive/는 지난 세션의 기록이다. 고치면 감사 추적이 무의미해진다.
# .claude/agents/를 덮어쓰면 이번 세션의 하네스가 조용히 뒤바뀐다.

set -uo pipefail
source "$(cd "$(dirname "$0")" && pwd)/lib-input"

read_hook_input
path=$(json_field "tool_input.file_path")
[ -z "$path" ] && exit 0

norm=$(printf '%s' "$path" | tr '\\' '/')

# ── 지난 세션 기록 보호 ──────────────────────────────────────────
case "$norm" in
    */_archive/*|_archive/*)
        block "차단됨 — _archive/는 지난 세션의 기록이다. 고치지 않는다.

경로: $path

지난 세션이 무엇을 왜 했는지 남긴 감사 추적이다. 읽는 것은 자유지만
쓰는 것은 허용하지 않는다. 이번 세션의 산출물은 _workspace/에 쓴다."
        ;;
esac

# ── 에이전트 정의 덮어쓰기 방지 ──────────────────────────────────
case "$norm" in
    */.claude/agents/*.md|.claude/agents/*.md)
        if [ -f "$path" ]; then
            block "차단됨 — 이미 존재하는 에이전트 정의를 덮어쓰려 한다.

경로: $path

이번 세션의 하네스가 조용히 뒤바뀐다. 셋 중 하나를 택한다:

  1. 기존 정의가 이 역할을 이미 담고 있다 → 새로 만들지 말고 그대로 쓴다
  2. 역할을 넓혀야 한다 → Edit로 해당 부분만 고친다
  3. 다른 역할이다 → 다른 이름으로 만든다"
        fi
        ;;
esac

exit 0

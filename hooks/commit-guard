#!/usr/bin/env bash
# PreToolUse(Bash) — 절대 규칙 1·9번을 강제한다.
#
# 1. 보호 브랜치 직접 커밋 차단
# 9. AI 산출물이 섞인 커밋 차단
#
# 규칙 2(테스트를 마친 커밋)는 여기서 판정하지 않는다. 파일 수정 시각과
# build/test-results 시각을 비교하는 방식이었는데, 주석 한 줄만 고쳐도
# 걸리고 Gradle이 up-to-date로 건너뛰어도 걸렸다. 되돌릴 수 있는 실수를
# 추측으로 막다가 오탐이 쌓이면 훅 전체를 우회하게 된다.
# 여기 남긴 둘은 성격이 다르다 — public 저장소에 한 번 올라간 시크릿과
# 보호 브랜치 커밋은 지워도 히스토리에 남는다. 그래서 기계가 막는다.

set -uo pipefail
source "$(cd "$(dirname "$0")" && pwd)/lib-input"

read_hook_input
cmd=$(json_field "tool_input.command")
[ -z "$cmd" ] && exit 0

flat=$(printf '%s' "$cmd" | tr '\n' ' ')

# 문자열 "git commit"을 그대로 찾으면 안 된다 — `git -C <경로> commit`이나
# `git --no-pager commit`처럼 사이에 옵션이 끼면 통째로 안 걸린다.
# 2026-08-09에 이 구멍을 실물로 확인했다: `git -C <저장소> commit`이 보호 브랜치
# 검사를 **한 번도 통과하지 않고 그냥 지나갔다.** 막힌 줄 알았던 것이 안 막혀 있었다.
#
# 옵션은 순서가 자유롭고(`git --no-pager -C <경로> commit`), `-C`·`-c`는 뒤에
# 인자를 하나 더 먹는다. 그래서 「인자를 먹는 옵션」을 먼저 놓고 반복시킨다.
printf '%s' "$flat" \
    | grep -Eq '(^|[;&|[:space:]])git([[:space:]]+(-[cC][[:space:]]+("[^"]+"|[^[:space:]]+)|--?[^[:space:]]+))*[[:space:]]+commit([[:space:]]|$)' \
    || exit 0

# 훅은 명령의 cwd가 아니라 세션 cwd에서 돈다. 그래서 다른 저장소에 커밋하는
# 명령까지 이 저장소의 브랜치로 판정한다 — 2026-08-09에 실제로 그렇게 막혔다.
# 코드 저장소(main)에서 세션을 열고 위키 저장소의 feature 브랜치에 커밋하는데
# "보호 브랜치에 직접 커밋"으로 차단됐다. 규칙 1번의 목적은 하나도 안 깨진 상태였다.
#
# 명령이 대상 저장소를 밝혔으면(git -C <경로> 또는 앞머리의 cd <경로>) 거기서 판정한다.
# 그 경로가 저장소가 아니면 옮기지 않는다 — 판정을 건너뛰는 것보다 세션 cwd로
# 판정하는 편이 안전하다. 거짓 통과는 히스토리에 남아 되돌려도 안 지워진다.
#
# 앞머리의 cd 를 먼저 본다. `git -C` 는 커밋 메시지 본문에도 나올 수 있어서
# 뒤에 둔다 — 2026-08-09에 메시지에 적은 `git -C <경로>` 를 진짜 명령으로 읽고
# 엉뚱한 경로로 판정한 적이 있다. 앞머리의 cd 는 그런 혼동이 없다.
target=$(printf '%s' "$flat" | grep -oE '^[[:space:]]*cd[[:space:]]+("[^"]+"|[^[:space:]]+)' | head -1 \
    | sed -E 's/^[[:space:]]*cd[[:space:]]+//; s/^"//; s/"$//')
if [ -z "$target" ]; then
    target=$(printf '%s' "$flat" | grep -oE 'git[[:space:]]+-C[[:space:]]+("[^"]+"|[^[:space:]]+)' | head -1 \
        | sed -E 's/^git[[:space:]]+-C[[:space:]]+//; s/^"//; s/"$//')
fi
if [ -n "$target" ] && [ -d "$target" ] \
        && git -C "$target" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    cd "$target" || exit 0
fi

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

# ── 규칙 1: 보호 브랜치 ──────────────────────────────────────────
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
case "$branch" in
    main|master|develop)
        block "차단됨 — 절대 규칙 1번: 보호 브랜치에 직접 커밋할 수 없다.

현재 브랜치: $branch

feature 브랜치를 만들고 거기서 작업한다:
    git switch -c feature/<기능이름>"
        ;;
esac

# ── 규칙 9: AI 산출물 ────────────────────────────────────────────
staged=$(git diff --cached --name-only 2>/dev/null)
if [ -n "$staged" ]; then
    offenders=$(printf '%s\n' "$staged" \
        | grep -E '(^|/)(\.claude/|_workspace/|_archive/|CLAUDE\.md$|AGENTS\.md$)' || true)
    if [ -n "$offenders" ]; then
        block "차단됨 — 절대 규칙 9번: AI 산출물은 GitHub에 올리지 않는다.

스테이지에 올라온 파일:
$offenders

.gitignore에 다음을 추가하고 스테이지에서 내린다:
    .claude/
    _workspace/
    _archive/
    CLAUDE.md
    **/CLAUDE.md

    git restore --staged <파일>"
    fi
fi

exit 0

#!/usr/bin/env bash
# PreToolUse(Bash) — 절대 규칙 1·9번을 강제한다.
#
# 1. 보호 브랜치 직접 커밋 차단
# 9. AI 산출물이 섞인 커밋 차단
#
# 규칙 2(테스트를 마친 커밋)는 여기서 판정하지 않는다. 파일 수정 시각과
# build/test-results 시각을 비교하는 방식이었는데, 주석 한 줄만 고쳐도
# 걸리고 Gradle이 up-to-date로 건너뛰어도 걸렸다. 되돌릴 수 있는 실수를
# 추측으로 막다가 오탐이 쌓이면 훅 전체를 우회하게 된다.
# 여기 남긴 둘은 성격이 다르다 — public 저장소에 한 번 올라간 시크릿과
# 보호 브랜치 커밋은 지워도 히스토리에 남는다. 그래서 기계가 막는다.

set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
source "$here/lib-input"
source "$here/lib-cmd"

read_hook_input
cmd=$(json_field "tool_input.command")
[ -z "$cmd" ] && exit 0

flat=$(flatten_command "$cmd")

is_commit_command "$flat" || exit 0
cd_to_target_repo "$flat" || exit 0

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

# ── 규칙 1: 보호 브랜치 ──────────────────────────────────────────
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
case "$branch" in
    main|master|develop)
        block "차단됨 — 절대 규칙 1번: 보호 브랜치에 직접 커밋할 수 없다.

현재 브랜치: $branch

feature 브랜치를 만들고 거기서 작업한다:
    git switch -c feature/<기능이름>"
        ;;
esac

# ── 규칙 9: AI 산출물 ────────────────────────────────────────────
# `git commit -a`면 인덱스에 없는 변경도 커밋에 들어간다. 인덱스만 보면
# 이미 추적 중인 CLAUDE.md 를 고쳐 -a 로 커밋하는 경로를 통째로 못 봤다.
staged=$(committed_files "$flat")
if [ -n "$staged" ]; then
    offenders=$(printf '%s\n' "$staged" \
        | grep -E '(^|/)(\.claude/|\.harness/|_workspace/|_archive/|CLAUDE\.md$|AGENTS\.md$)' || true)
    if [ -n "$offenders" ]; then
        block "차단됨 — 절대 규칙 9번: AI 산출물은 GitHub에 올리지 않는다.

스테이지에 올라온 파일:
$offenders

.gitignore에 다음을 추가하고 스테이지에서 내린다:
    .claude/
    .harness/
    _workspace/
    _archive/
    CLAUDE.md
    **/CLAUDE.md

    git restore --staged <파일>"
    fi
fi

# ── 훅 스크립트의 실행 권한 비트 ─────────────────────────────────
# 이 저장소는 core.fileMode=false 라 `chmod +x`가 git에 반영되지 않는다.
# 로컬에서는 실행 가능해 안 드러나고 **새로 클론한 사람에게만 터진다.**
# README에 경고를 적어 뒀는데도 2026-08-11 하루에 두 번 놓쳤다
# (secret-guard·lib-cmd). 글로 막는 것이 반복해서 실패하면 기계로 옮길 문제다.
if [ -n "$staged" ]; then
    unexec=$(printf '%s\n' "$staged" | grep -E '(^|/)hooks/[^/.]+$' | while IFS= read -r f; do
        [ "$(committed_mode "$flat" "$f")" = "100644" ] && printf '  %s\n' "$f"
    done)
    if [ -n "$unexec" ]; then
        block "차단됨 — 훅 스크립트에 실행 권한 비트가 없다.

$unexec
이 저장소는 core.fileMode=false 라 chmod +x 가 git에 안 잡힌다. 로컬에서는
돌아가고 새로 클론한 사람에게만 터진다.

    git update-index --chmod=+x <파일>
    git ls-files -s hooks/     # 전부 100755 여야 한다"
    fi
fi

exit 0

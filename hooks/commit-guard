#!/usr/bin/env bash
# PreToolUse(Bash) — 절대 규칙 1·9번을 강제한다.
#
# 1. 보호 브랜치 직접 커밋 차단
# 9. AI 산출물이 섞인 커밋 차단
#
# 규칙 2(테스트를 마친 커밋)는 여기서 판정하지 않는다. 파일 수정 시각과
# build/test-results 시각을 비교하는 방식이었는데, 주석 한 줄만 고쳐도
# 걸리고 Gradle이 up-to-date로 건너뛰어도 걸렸다. 되돌릴 수 있는 실수를
# 추측으로 막다가 오탐이 쌓이면 훅 전체를 우회하게 된다.
# 여기 남긴 둘은 성격이 다르다 — public 저장소에 한 번 올라간 시크릿과
# 보호 브랜치 커밋은 지워도 히스토리에 남는다. 그래서 기계가 막는다.

set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
source "$here/lib-input"
source "$here/lib-cmd"
source "$here/lib-repo"

read_hook_input
cmd=$(json_field "tool_input.command")
[ -z "$cmd" ] && exit 0

flat=$(flatten_command "$cmd")

is_commit_command "$flat" || exit 0
cd_to_target_repo "$flat" || exit 0

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

# ── 규칙 1: 보호 브랜치 ──────────────────────────────────────────
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
case "$branch" in
    main|master|develop)
        block "차단됨 — 절대 규칙 1번: 보호 브랜치에 직접 커밋할 수 없다.

현재 브랜치: $branch

feature 브랜치를 만들고 거기서 작업한다:
    git switch -c feature/<기능이름>"
        ;;
esac

# ── 규칙 2: 머지가 끝난 브랜치를 다시 쓰지 않는다 ────────────────
# PR 이 머지되면 그 브랜치의 일은 끝났다. 거기에 새 커밋을 얹으면 두 갈래로
# 샌다 — PR 없이 원격에만 뜨거나, base 를 기능 브랜치로 잡은 스택 PR 이 된다.
# 스택 PR 은 claude 리뷰가 아예 안 돈다(pr 스킬 참고).
#
# 2026-08-11에 실물로 겪었다. PR #18 이 머지된 뒤 같은 브랜치에 커밋 하나가
# 얹혀 원격에만 떠 있었고, 다음 세션이 그것을 발견할 때까지 아무 데도 안 갔다.
#
# 판정에 세 조건이 다 필요하다.
#
#   1. 이 브랜치가 원격에 있다        — 방금 판 브랜치는 여기서 걸러진다
#   2. tip 이 통합 브랜치와 **다르다** — 도달 가능하다는 것과 머지됐다는 것은
#      다르다. 커밋 전에 push 한 브랜치는 tip 이 통합 브랜치와 같은데,
#      그것까지 막으면 첫 커밋부터 아무것도 못 한다 (codex, PR #34)
#   3. tip 이 통합 브랜치 안에 들어가 있다 — 머지의 증거
#
# 판정 전에 통합 브랜치를 새로 고친다. 머지는 대개 GitHub 에서 일어나므로
# 로컬의 `origin/<통합>` 은 머지 전 커밋을 가리키고 있다. 그대로 재면
# **막아야 할 첫 커밋이 정확히 통과한다** (codex, PR #34).
# 실패해도 그냥 진행한다 — 오프라인이면 로컬 ref 로 재는 수밖에 없다.
if git rev-parse --verify -q "origin/$branch" >/dev/null 2>&1; then
    integ=$(default_branch)
    if [ -n "$integ" ]; then
        GIT_TERMINAL_PROMPT=0 git fetch -q --no-tags origin "$integ" 2>/dev/null || true
    fi
    if [ -n "$integ" ] && git rev-parse --verify -q "origin/$integ" >/dev/null 2>&1 \
            && [ "$(git rev-parse HEAD)" != "$(git rev-parse "origin/$integ")" ] \
            && git merge-base --is-ancestor HEAD "origin/$integ" 2>/dev/null; then
        block "차단됨 — 절대 규칙 2번: 머지가 끝난 브랜치를 다시 쓰고 있다.

현재 브랜치: $branch (origin/$integ 에 이미 들어가 있다)

여기에 커밋을 얹으면 PR 없이 원격에만 뜨거나, 스택 PR 이 되어
claude 리뷰가 아예 안 돈다.

origin/$integ 에서 새 브랜치를 판다:
    git switch -c <새이름> origin/$integ"
    fi
fi

# ── 규칙 9: AI 산출물 ────────────────────────────────────────────
# 여기도 넓게 본다. 한때 「`.claude/` 가 세션 내내 워킹트리에 있으니 넓히면
# 다 막힌다」고 보고 인덱스에 묶어 뒀는데, **근거가 틀렸다** —
# `git diff --name-only` 는 **추적 파일의 변경**만 나열하므로 .gitignore 된
# `.claude/` 는 애초에 안 나온다. 반대로 이미 추적 중인 `CLAUDE.md` 는
# .gitignore 로 못 막으므로, 인덱스만 보면 `-a` 커밋이 그대로 지나간다
# (codex, PR #28).
staged=$(committable_files)
if [ -n "$staged" ]; then
    offenders=$(printf '%s\n' "$staged" \
        | grep -E '(^|/)(\.claude/|\.harness/|_workspace/|_archive/|CLAUDE\.md$|AGENTS\.md$)' || true)
    if [ -n "$offenders" ]; then
        block "차단됨 — 절대 규칙 9번: AI 산출물은 GitHub에 올리지 않는다.

스테이지에 올라온 파일:
$offenders

.gitignore에 다음을 추가하고 스테이지에서 내린다:
    .claude/
    .harness/
    _workspace/
    _archive/
    CLAUDE.md
    **/CLAUDE.md

    git restore --staged <파일>"
    fi
fi

# ── 훅 스크립트의 실행 권한 비트 ─────────────────────────────────
# 이 저장소는 core.fileMode=false 라 `chmod +x`가 git에 반영되지 않는다.
# 로컬에서는 실행 가능해 안 드러나고 **새로 클론한 사람에게만 터진다.**
# README에 경고를 적어 뒀는데도 2026-08-11 하루에 두 번 놓쳤다
# (secret-guard·lib-cmd). 글로 막는 것이 반복해서 실패하면 기계로 옮길 문제다.
# `-a` 커밋은 실행 비트 변경만 담을 수도 있어 인덱스에 안 나타난다.
# 위에서 구한 넓은 목록을 그대로 쓴다.
if [ -n "$staged" ]; then
    unexec=$(printf '%s\n' "$staged" | grep -E '(^|/)hooks/[^/.]+$' | while IFS= read -r f || [ -n "$f" ]; do
        is_executable_commit "$f" || printf '  %s\n' "$f"
    done)
    if [ -n "$unexec" ]; then
        block "차단됨 — 훅 스크립트에 실행 권한 비트가 없다.

$unexec
이 저장소는 core.fileMode=false 라 chmod +x 가 git에 안 잡힌다. 로컬에서는
돌아가고 새로 클론한 사람에게만 터진다.

    git update-index --chmod=+x <파일>
    git ls-files -s hooks/     # 전부 100755 여야 한다"
    fi
fi

exit 0

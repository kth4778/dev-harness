#!/usr/bin/env bash
# 훅 공통 — Bash 도구가 실행하려는 명령 문자열을 해석한다.
#
# commit-guard와 secret-guard가 같은 판정을 복붙으로 나눠 갖고 있었다.
# 2026-08-09에 commit-guard 쪽 커밋 감지에서 구멍(`git -C <경로> commit`이
# 그냥 통과)을 고쳤는데, 복사본이 있는 secret-guard는 그대로 새고 있었다.
# 2026-08-11에 그 사실이 드러나 여기로 합쳤다. 고칠 자리를 하나로 둔다.

# 개행을 눌러 한 줄로 만든다. 개행을 이용한 우회를 막는다.
flatten_command() {
    printf '%s' "$1" | tr '\n' ' '
}

# 따옴표 안 텍스트를 버린다. 단, 따옴표 안이 통째로 플래그 하나면 벗겨서 살린다.
#
# 이 자리에서 두 번 헛짚었다(2026-08-11).
#
#   1. 따옴표 안을 통째로 버렸다 → `git commit "-a" -m x` 가 샜다.
#      셸은 `"-a"` 를 git 에 `-a` 로 그대로 넘긴다 (codex, PR #22)
#   2. 그래서 `-m` 값만 골라 지우고 나머지 따옴표를 벗겼다 → 메시지가 노출됐다.
#      `-qm "docs: -a 옵션"` 의 `-qm` 은 `-m` 패턴에 안 걸려 메시지가 남고,
#      따옴표만 벗겨지자 본문의 `-a` 가 진짜 플래그로 읽혔다 (claude, PR #23)
#
# 옵션 이름을 열거하는 한 묶음 플래그(`-qm`·`-vam`)가 계속 빠진다. 그래서
# 열거를 버리고 **따옴표 안의 모양**으로 판정한다 — 플래그 한 개면 인자이고,
# 문장이면 메시지다. 셸이 넘기는 것과 같은 기준이라 옵션 목록을 안 늘려도 된다.
strip_quoted_text() {
    printf '%s' "$1" | sed -E '
        s/"(-{1,2}[A-Za-z][A-Za-z0-9-]*)"/\1/g
        s/'\''(-{1,2}[A-Za-z][A-Za-z0-9-]*)'\''/\1/g
        s/"[^"]*"//g
        s/'\''[^'\'']*'\''//g
    '
}

# 커밋 명령이 든 조각만 남긴다.
#
# Bash 도구는 명령을 여러 개 이어 보낸다. 전체 문자열에서 플래그를 찾으면
# 뒤따르는 남의 인자를 커밋 옵션으로 읽는다 — `git commit -m ok && printf x "-a"`가
# -a 커밋으로 판정돼 워킹트리 전체를 검사하고 엉뚱한 것을 막았다.
# 2026-08-11 codex 리뷰(PR #23)가 잡았다.
#
# 따옴표 안을 먼저 버린 뒤에 쪼갠다. 커밋 메시지 본문에 든 `;`·`&&`로 조각이
# 잘못 갈라지는 것을 막는다.
commit_segment() {
    local bare; bare=$(strip_quoted_text "$1")
    # `|| [ -n "$seg" ]` 가 없으면 개행 없이 끝나는 마지막 조각을 버린다.
    # 명령이 하나뿐일 때가 바로 그 경우라 판정이 통째로 죽는다.
    printf '%s' "$bare" | sed -E 's/(&&|\|\||;|\|)/\n/g' | while IFS= read -r seg || [ -n "$seg" ]; do
        is_commit_command " $seg " && printf '%s ' "$seg"
    done
}

# 커밋 명령인가.
#
# 문자열 "git commit"을 그대로 찾으면 안 된다 — `git -C <경로> commit`이나
# `git --no-pager commit`처럼 사이에 옵션이 끼면 통째로 안 걸린다.
# 옵션은 순서가 자유롭고(`git --no-pager -C <경로> commit`), `-C`·`-c`는 뒤에
# 인자를 하나 더 먹는다. 그래서 「인자를 먹는 옵션」을 먼저 놓고 반복시킨다.
is_commit_command() {
    printf '%s' "$1" | grep -Eq \
        '(^|[;&|[:space:]])git([[:space:]]+(-[cC][[:space:]]+("[^"]+"|[^[:space:]]+)|--?[^[:space:]]+))*[[:space:]]+commit([[:space:]]|$)'
}

# `git commit -a`처럼 스테이징을 건너뛰고 커밋하는가.
#
# 이 경우 인덱스에 없는 변경까지 커밋에 들어간다. 인덱스만 검사하는 훅은
# 그 변경을 통째로 못 본다.
#
# `-a`·`--all`·묶음 플래그(`-am`)를 본다. `--amend`는 `--`로 시작하므로
# 묶음 플래그 갈래에 걸리지 않는다.
commit_stages_all() {
    local seg; seg=$(commit_segment "$1")
    [ -n "$seg" ] || return 1
    printf ' %s ' "$seg" | grep -Eq '[[:space:]]-[a-zA-Z]*a[a-zA-Z]*([[:space:]]|$)|[[:space:]]--all([[:space:]]|$)'
}

# 명령이 밝힌 대상 저장소 경로. 안 밝혔으면 빈 출력.
#
# 훅은 명령의 cwd가 아니라 세션 cwd에서 돈다. 그래서 다른 저장소를 향한
# 명령까지 이 저장소 기준으로 판정한다 — 2026-08-09에 실제로 그렇게 막혔다.
# 코드 저장소(main)에서 세션을 열고 위키 저장소의 feature 브랜치에 커밋하는데
# "보호 브랜치에 직접 커밋"으로 차단됐다.
#
# 앞머리의 cd 를 먼저 본다. `git -C` 는 커밋 메시지 본문에도 나올 수 있어서
# 뒤에 둔다 — 2026-08-09에 메시지에 적은 `git -C <경로>` 를 진짜 명령으로 읽고
# 엉뚱한 경로로 판정한 적이 있다. 앞머리의 cd 는 그런 혼동이 없다.
command_target_dir() {
    local flat="$1" t
    t=$(printf '%s' "$flat" | grep -oE '^[[:space:]]*cd[[:space:]]+("[^"]+"|[^[:space:]]+)' | head -1 \
        | sed -E 's/^[[:space:]]*cd[[:space:]]+//; s/^"//; s/"$//')
    if [ -z "$t" ]; then
        t=$(printf '%s' "$flat" | grep -oE 'git[[:space:]]+-C[[:space:]]+("[^"]+"|[^[:space:]]+)' | head -1 \
            | sed -E 's/^git[[:space:]]+-C[[:space:]]+//; s/^"//; s/"$//')
    fi
    printf '%s' "$t"
}

# 대상 저장소가 밝혀져 있으면 그리로 옮긴다. 그 경로가 저장소가 아니면
# 옮기지 않는다 — 판정을 건너뛰는 것보다 세션 cwd로 판정하는 편이 안전하다.
# 거짓 통과는 히스토리에 남아 되돌려도 안 지워진다.
cd_to_target_repo() {
    local t; t=$(command_target_dir "$1")
    if [ -n "$t" ] && [ -d "$t" ] \
            && git -C "$t" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        cd "$t" || return 1
    fi
    return 0
}

# 이 커밋에 실제로 들어갈 파일 목록. 경로는 저장소 루트 기준이다.
#
# 평소에는 인덱스에 올라온 것만이다. `-a`가 붙으면 추적 중인 파일의 워킹트리
# 수정까지 함께 커밋되므로 그것도 목록에 넣는다.
#
# 거르는 것은 삭제(`d`)뿐이다. 타입을 하나씩 적어(ACM) 두면 적지 않은 타입이
# 조용히 빠진다 — 이름이 바뀐 파일(`R`)이 그렇게 샜다. `git mv ordinary CLAUDE.md`가
# 규칙 9 검사를 그냥 지나갔다. 2026-08-11 codex 리뷰(PR #22)가 잡았다.
#
# `core.quotePath=false`를 붙이는 이유: 기본값이면 비ASCII 이름을 `"\352\262..."`
# 처럼 따옴표+8진수로 뱉는다. 그 표기는 어떤 경로 패턴과도 안 맞아 검사에서
# 통째로 빠진다. 2026-08-11 codex 리뷰(PR #23)가 잡았다.
committed_files() {
    if commit_stages_all "$1"; then
        git -c core.quotePath=false diff HEAD --name-only --diff-filter=d 2>/dev/null
    else
        git -c core.quotePath=false diff --cached --name-only --diff-filter=d 2>/dev/null
    fi
}

# 이 커밋이 그 파일에 기록할 권한 모드(100644 / 100755). 모르면 빈 출력.
#
# 평소에는 인덱스에 든 모드가 그대로 기록된다. 그런데 `core.fileMode=true`인
# 저장소에서 `-a`로 커밋하면 **워킹트리의 실행 비트 변경까지 그때 함께
# 스테이징된다** — 인덱스만 보면 아직 옛 모드라 바뀔 것을 못 본다.
# 2026-08-11 codex 리뷰(PR #23)가 잡았다.
#
# pathspec에 `:/`를 붙이는 이유: 목록의 경로는 저장소 루트 기준인데 pathspec은
# cwd 기준으로 풀린다. 하위 폴더에서 커밋하면 아무것도 안 맞아 모드가 빈
# 문자열이 되고, 비교가 늘 거짓이라 **검사가 통째로 조용히 통과했다.**
# committed_content 에서 고친 것과 같은 종류를 여기에 다시 심었던 것을
# 2026-08-11 claude 리뷰(PR #23)가 잡았다.
committed_mode() {
    local flat="$1" f="$2" root
    if commit_stages_all "$flat" && [ "$(git config --get core.fileMode)" != "false" ]; then
        root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
        if [ -x "$root/$f" ]; then printf '100755'; else printf '100644'; fi
    else
        git ls-files -s -- ":/$f" 2>/dev/null | awk '{print $1}'
    fi
}

# 커밋에 들어갈 그 파일의 내용을 뱉는다.
#
# `-a`가 붙으면 워킹트리 쪽이 커밋된다. 아니면 인덱스 쪽이다 — 스테이징한 뒤
# 파일을 고치면 둘이 어긋나고, 커밋에 들어가는 것은 인덱스 쪽이다.
#
# 워킹트리를 읽을 때 저장소 루트를 앞에 붙인다. 목록의 경로가 루트 기준인데
# 훅의 cwd는 하위 폴더일 수 있다 — `sub/`에서 커밋하면 `sub/sub/config`를
# 찾다가 아무것도 못 읽고 조용히 통과했다. 2026-08-11 codex 리뷰가 잡았다.
committed_content() {
    local flat="$1" f="$2" root
    if commit_stages_all "$flat"; then
        root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
        [ -f "$root/$f" ] && cat "$root/$f" 2>/dev/null
    else
        git show ":$f" 2>/dev/null
    fi
}

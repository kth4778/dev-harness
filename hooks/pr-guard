#!/usr/bin/env bash
# PreToolUse(Bash) — 절대 규칙 10번을 강제한다.
#
# gh는 저장소 소유자 토큰으로 인증된다. 이 명령들을 실행하면 사용자가 자기 PR에
# 리뷰를 단 것처럼 기록된다. 리뷰는 봇 2개(claudecode·codex)만 남겨야 한다.

set -uo pipefail
source "$(cd "$(dirname "$0")" && pwd)/lib-input"

read_hook_input
cmd=$(json_field "tool_input.command")
[ -z "$cmd" ] && exit 0

# 한 줄로 눌러 개행을 이용한 우회를 막는다
flat=$(printf '%s' "$cmd" | tr '\n' ' ')

deny() {
    block "차단됨 — 절대 규칙 10번: 사람 계정으로 PR에 리뷰·코멘트를 달지 않는다.

막힌 명령: $1

gh는 저장소 소유자 토큰으로 인증되어 있다. 이 명령을 실행하면 GitHub에
사용자가 자기 PR에 리뷰를 단 것으로 기록된다. 리뷰는 claudecode·codex 봇
2개만 남겨야 한다.

지적할 내용이 있으면 채팅으로 보고한다. 코드를 고쳐야 하면 로컬에서 고치고
한 라운드분을 모아 push 한 번으로 올린다."
}

# 봇 호출 토큰만 담긴 코멘트는 허용한다 — 리뷰가 아니라 명령이기 때문이다.
# 토큰 외에 한 글자라도 섞이면 리뷰 내용으로 보고 막는다.
#
# 예외 하나: 언어 지시. 봇이 기본값으로 영어 리뷰를 쓰는데, 이 팀은 한국어로 읽는다.
# 지시할 자리가 코멘트뿐이라(Codex는 AGENTS.md를 커밋 안 하는 이 저장소에서
# 다른 설정 통로가 없다) 토큰 뒤 "한국어로"만 붙일 수 있게 연다.
# 그 외의 글자는 여전히 리뷰 내용으로 보고 막는다 — 목록을 좁게 유지하는 것이
# 이 가드의 전부다.
#
# **본문을 떼어내려는 시도를 버렸다.** 셸 문자열에서 인용을 벗겨 본문만 꺼내는
# 방식은 이 세션에서 세 번 뚫렸다.
#
#   1. 쌍따옴표만 읽어 홑따옴표를 못 읽었다 → 봇 호출이 거짓 차단
#   2. 파일 형태를 읽게 했더니 실행 직전에 파일이 바뀌는 틈이 생겼다
#   3. 인용 뒤에 문자를 잇거나(`'@codex review'덧붙임`) `--body` 를 두 번
#      쓰면(`--body "… --body '@codex review'"`) greedy 매치가 뒷쪽만 읽어
#      **훅이 본 것과 전송되는 것이 달라졌다**
#
# 셋 다 「더 정확히 파싱한다」로 대응했고 셋 다 다시 뚫렸다. 같은 자리를 세 번
# 고치면 판정을 의심한다(RULES.md) — 그래서 판정 방식을 바꾼다.
#
# **명령줄 전체가 허용 형태와 글자 하나까지 같은지**만 본다. 앞뒤에 무엇이
# 붙어도, 인용이 어긋나도, 다른 명령이 이어져도 안 맞으면 막는다.
# 봇 호출은 한 줄이므로 이렇게 좁혀도 잃는 것이 없다.
#
#   [cd <경로> &&] gh pr comment <번호> --body '<토큰>'
#
# 토큰 뒤 `한국어로`만 붙일 수 있다. 봇이 기본값으로 영어 리뷰를 쓰는데 지시할
# 자리가 코멘트뿐이기 때문이다(Codex 는 AGENTS.md 를 커밋 안 하는 이 저장소에서
# 다른 설정 통로가 없다).
is_bot_trigger() {
    local one tok pre post
    # **원문을 바꿔서 재지 않는다.** 탭을 공백으로 바꾸고 대조하면
    # `--body '@codex<탭>review'` 가 통과하는데, 셸과 gh 는 탭이 든 본문을
    # 그대로 보낸다 — 훅이 본 것과 전송되는 것이 갈린다 (codex, PR #61).
    # 제어 공백이 하나라도 있으면 그 자리에서 막는다. 탭·개행만 막았더니 끝에
    # 붙은 캐리지 리턴이 통과했다 — `[[:space:]]*$` 가 그것을 공백으로 받아
    # 주는데 gh 는 본문에 담아 보낸다 (codex, PR #62).
    # 봇 호출은 한 줄이므로 이렇게 좁혀도 잃는 것이 없다.
    case "$cmd" in
        *$'\t'*|*$'\n'*|*$'\r'*|*$'\f'*|*$'\v'*) return 1 ;;
    esac
    one="$flat"

    tok='@(codex|claude) review( 한국어로)?'
    # `cd <경로> &&` 하나까지만 앞에 붙을 수 있다. 경로에 명령 구분자나
    # 치환 문자가 들어가면 거부한다 — 거기로 다른 명령을 숨길 수 있다.
    pre='^[[:space:]]*(cd[[:space:]]+[^;&|<>()`$]+[[:space:]]*&&[[:space:]]*)?'
    pre="${pre}"'gh[[:space:]]+pr[[:space:]]+comment[[:space:]]+[0-9]+[[:space:]]+(--body|-b)([[:space:]]+|=)'
    # `[[:space:]]` 는 \r 도 받는다. 평범한 빈칸만 허용한다.
    post=' *$'

    # 홑따옴표·쌍따옴표 두 형태. 여는 것과 닫는 것이 같아야 한다.
    # (`grep -c` 를 쓴다. `-q` 는 매치하자마자 닫혀 SIGPIPE 를 부른다.)
    [ "$(printf '%s' "$one" | grep -Ec "${pre}'${tok}'${post}" || true)" -gt 0 ] && return 0
    [ "$(printf '%s' "$one" | grep -Ec "${pre}\"${tok}\"${post}" || true)" -gt 0 ] && return 0
    return 1
}

# `gh pr edit --body`는 여기서 막지 않는다. PR 설명은 작성자가 쓰는 자리이고
# GitHub에 리뷰로 기록되지 않는다 — 규칙 10이 겨냥하는 것이 아니다.
# 막아 두니 PR을 올린 뒤 설명의 오타 하나도 고칠 수 없었다. 2026-08-11에
# 실물로 겪었다: 본문의 백틱이 셸에 먹혀 첫 줄이 깨졌는데 되돌릴 방법이 없었다.
# 거짓 차단은 사람이 훅을 끄게 만든다 (RULES.md 「훅을 고칠 때」절).
# **공백을 고른 뒤 서브커맨드를 찾는다.** 낱말 사이에 탭이나 공백 두 개를 넣으면
# 셸에서는 똑같이 동작하는데 `*"gh pr comment"*` 에는 안 맞아, 판정 함수까지
# 도달조차 못 했다 — `gh<탭>pr<탭>comment 61 --body '사람 리뷰'` 가 통과했다
# (codex, PR #71 이 재현). 붙임표 없는 낱말 경계는 전부 한 칸으로 만든다.
norm=$(printf '%s' "$flat" | tr '\t' ' ' | tr -s ' ')

case "$norm" in
    *"gh pr review"*)      deny "gh pr review" ;;
    *"gh issue comment"*)  deny "gh issue comment" ;;
    *"gh pr comment"*)
        # 판정에는 **원문**을 쓴다(is_bot_trigger 가 $cmd·$flat 를 본다).
        # 정규화한 문자열로 허용하면 탭이 든 본문이 통과한다 — PR #61 에서
        # 같은 이유로 뚫렸다.
        if ! is_bot_trigger; then
            deny "gh pr comment (봇 호출 토큰 외의 본문)"
        fi
        ;;
esac

# gh api로 우회하는 경로 — POST로 리뷰·코멘트를 만드는 호출만 막는다.
# 조회(GET)는 봇 리뷰를 읽어야 하므로 허용한다.
case "$norm" in
    *"gh api"*)
        case "$norm" in
            *"/reviews"*|*"/comments"*)
                # **필드 플래그를 전부 잡는다.** `-f `·`--field` 만 보다가
                # 표준 단축형 `-F`(--field 의 별칭), `--raw-field`, 붙여 쓴
                # `-fbody=x` 를 놓쳤다 — `gh api … -F body='사람 리뷰'` 로
                # 실제 코멘트가 만들어졌다 (codex, PR #71 이 재현).
                # 필드가 하나라도 붙으면 gh 는 기본 메서드를 POST 로 바꾼다.
                case "$norm" in
                    *"-X POST"*|*"--method POST"*|*"--input"* \
                    |*" -f"*|*" -F"*|*"--field"*|*"--raw-field"*)
                        deny "gh api로 리뷰·코멘트 생성"
                        ;;
                esac
                ;;
        esac
        ;;
esac

exit 0

#!/usr/bin/env bash
# PreToolUse(Bash) — 절대 규칙 10번을 강제한다.
#
# gh는 저장소 소유자 토큰으로 인증된다. 이 명령들을 실행하면 사용자가 자기 PR에
# 리뷰를 단 것처럼 기록된다. 리뷰는 봇 2개(claudecode·codex)만 남겨야 한다.

set -uo pipefail
source "$(cd "$(dirname "$0")" && pwd)/lib-input"

read_hook_input
cmd=$(json_field "tool_input.command")
[ -z "$cmd" ] && exit 0

# 한 줄로 눌러 개행을 이용한 우회를 막는다
flat=$(printf '%s' "$cmd" | tr '\n' ' ')

deny() {
    block "차단됨 — 절대 규칙 10번: 사람 계정으로 PR에 리뷰·코멘트를 달지 않는다.

막힌 명령: $1

gh는 저장소 소유자 토큰으로 인증되어 있다. 이 명령을 실행하면 GitHub에
사용자가 자기 PR에 리뷰를 단 것으로 기록된다. 리뷰는 claudecode·codex 봇
2개만 남겨야 한다.

지적할 내용이 있으면 채팅으로 보고한다. 코드를 고쳐야 하면 로컬에서 고치고
한 라운드분을 모아 push 한 번으로 올린다."
}

# 봇 호출 토큰만 담긴 코멘트는 허용한다 — 리뷰가 아니라 명령이기 때문이다.
# 토큰 외에 한 글자라도 섞이면 리뷰 내용으로 보고 막는다.
#
# 예외 하나: 언어 지시. 봇이 기본값으로 영어 리뷰를 쓰는데, 이 팀은 한국어로 읽는다.
# 지시할 자리가 코멘트뿐이라(Codex는 AGENTS.md를 커밋 안 하는 이 저장소에서
# 다른 설정 통로가 없다) 토큰 뒤 "한국어로"만 붙일 수 있게 연다.
# 그 외의 글자는 여전히 리뷰 내용으로 보고 막는다 — 목록을 좁게 유지하는 것이
# 이 가드의 전부다.
#
# 본문을 **쌍따옴표 하나만** 보고 읽고 있었다. 홑따옴표로 감싸면 — 셸에서
# 백틱과 $ 가 안 먹혀 오히려 권장되는 인용법이다 — 본문이 비어 fail-closed 로
# 걸린다. 2026-08-13 에 실물로 겪었다: 봇 호출 토큰을 홑따옴표로 넘겼더니
# 막혀서 봇을 부를 수 없었다.
#
# 거짓 차단은 사람이 훅을 끄게 만든다 (RULES.md 「훅을 고칠 때」절).
# **인용 형태 세 가지**(홑·쌍·붙임표)를 다 읽는다.
#
# **파일 형태는 읽지 않고 막는다.** 훅이 본 내용과 실제로 전송되는 내용이
# 다를 수 있기 때문이다 — 아래 갈래에 이유를 적었다.
is_bot_trigger() {
    local seg body f
    # 이 서브커맨드 뒤쪽만 본다. 앞에 붙은 `cd ... &&` 는 볼 필요가 없다.
    seg=$(printf '%s' "$flat" | sed -n "s/.*gh[[:space:]]\{1,\}pr[[:space:]]\{1,\}comment//p")
    case "$seg" in
        *--body-file*|*" -F "*|*" -F="*)
            # **파일 형태는 통과시키지 않는다.** 훅은 실행 *전에* 도는데, 같은
            # 명령줄이 파일을 덮어쓴 뒤 보낼 수 있다 —
            #   printf '리뷰 내용' > /tmp/b; <코멘트 명령> --body-file /tmp/b
            # 훅이 본 것과 전송되는 것이 다르다. 이 틈(TOCTOU)은 명령 문자열을
            # 아무리 잘 읽어도 못 막는다 (codex, PR #57).
            #
            # 파일을 읽어 판정하는 갈래를 앞 커밋에서 넣었다가 여기서 되돌린다.
            # 봇 호출은 한 줄이라 파일이 필요 없다 — 잃는 것이 없다.
            return 1
            ;;
        *)
            body=$(printf '%s' "$seg" | sed -E "s/.*(--body|-b)[=[:space:]]*//")
            # 인용부호가 있으면 그 안쪽만, 없으면 줄 끝까지. 넘치게 읽어도
            # 토큰과 안 맞아 차단되므로 fail-closed 방향이다.
            case "$body" in
                "'"*) body=$(printf '%s' "$body" | sed -E "s/^'//; s/'.*$//") ;;
                '"'*)  body=$(printf '%s' "$body" | sed -E 's/^"//; s/".*$//') ;;
            esac
            ;;
    esac
    # 줄바꿈은 지운다 — 파일로 넘기면 끝에 붙는다.
    body=$(printf '%s' "$body" | tr '\n' ' ')
    [ -z "$body" ] && return 1   # 본문을 못 읽으면 막는다 (fail-closed)
    body=$(printf '%s' "$body" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    case "$body" in
        "@codex review"|"@claude review") return 0 ;;
        "@codex review 한국어로"|"@claude review 한국어로") return 0 ;;
        *) return 1 ;;
    esac
}

# `gh pr edit --body`는 여기서 막지 않는다. PR 설명은 작성자가 쓰는 자리이고
# GitHub에 리뷰로 기록되지 않는다 — 규칙 10이 겨냥하는 것이 아니다.
# 막아 두니 PR을 올린 뒤 설명의 오타 하나도 고칠 수 없었다. 2026-08-11에
# 실물로 겪었다: 본문의 백틱이 셸에 먹혀 첫 줄이 깨졌는데 되돌릴 방법이 없었다.
# 거짓 차단은 사람이 훅을 끄게 만든다 (RULES.md 「훅을 고칠 때」절).
case "$flat" in
    *"gh pr review"*)      deny "gh pr review" ;;
    *"gh issue comment"*)  deny "gh issue comment" ;;
    *"gh pr comment"*)
        if ! is_bot_trigger; then
            deny "gh pr comment (봇 호출 토큰 외의 본문)"
        fi
        ;;
esac

# gh api로 우회하는 경로 — POST로 리뷰·코멘트를 만드는 호출만 막는다.
# 조회(GET)는 봇 리뷰를 읽어야 하므로 허용한다.
case "$flat" in
    *"gh api"*)
        case "$flat" in
            *"/reviews"*|*"/comments"*)
                case "$flat" in
                    *"-X POST"*|*"--method POST"*|*"-f "*|*"--field"*|*"--input"*)
                        deny "gh api로 리뷰·코멘트 생성"
                        ;;
                esac
                ;;
        esac
        ;;
esac

exit 0
